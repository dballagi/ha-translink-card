{
  "name": "translink-schedule-card",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && esbuild src/translink-schedule-card.ts --bundle --format=esm --splitting --minify --target=es2022 --loader:.css=text --outdir=../custom_components/translink_schedule/frontend --entry-names=translink-schedule-card --chunk-names=chunks/[name]-[hash]",
    "clean": "node -e \"require('fs').rmSync('../custom_components/translink_schedule/frontend/chunks',{recursive:true,force:true})\"",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
